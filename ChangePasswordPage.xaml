<Window x:Class="SushiGo.ChangePasswordPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SushiGo"
        xmlns:p="clr-namespace:SushiGo.Properties"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.ChangePasswordPage_Title}"
        Width="1440"
        Height="1024"
        Background="#FFFAF4">

    <Canvas>

        <TextBlock
            Text="{x:Static p:Resources.ChangePasswordPage_Title}"
            Canvas.Left="309"
            Canvas.Top="116"
            Width="887"
            Height="134"
            FontFamily="./Fonts/#Protest Strike"
            FontSize="96"
            FontWeight="Normal"
            Foreground="#9B2424"
            TextAlignment="Center"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"/>

        <TextBlock
            Text="{x:Static p:Resources.ChangePasswordPage_Instructions}"
            Canvas.Left="379"
            Canvas.Top="264"
            Width="681"
            Height="66"
            FontFamily="Inter"
            FontSize="24"
            Foreground="#000000"
            TextWrapping="Wrap"
            TextAlignment="Center"
            VerticalAlignment="Top"/>

        <TextBlock
            Text="{x:Static p:Resources.ChangePasswordPage_Email}"
            Canvas.Left="523"
            Canvas.Top="447"
            Width="340"
            Height="23"
            FontFamily="Inter"
            FontSize="20"
            Foreground="#000000"/>

        <TextBox
            x:Name="txtEmail"
            Canvas.Left="523"
            Canvas.Top="481"
            Width="394"
            Height="40"
            Padding="14,0,14,0"
            FontFamily="Inter"
            FontSize="16"
            Background="#FFFAF4"
            BorderBrush="#B3B3B3"
            BorderThickness="1"/>

        <TextBlock
            Text="{x:Static p:Resources.ChangePasswordPage_Code}"
            Canvas.Left="523"
            Canvas.Top="563"
            Width="340"
            Height="23"
            FontFamily="Inter"
            FontSize="20"
            Foreground="#000000"/>

        <TextBox
            x:Name="txtCode"
            Canvas.Left="523"
            Canvas.Top="598"
            Width="394"
            Height="40"
            Padding="14,0,14,0"
            FontFamily="Inter"
            FontSize="16"
            Background="#FFFAF4"
            BorderBrush="#B3B3B3"
            BorderThickness="1"/>

        <Button
            Content="{x:Static p:Resources.ChangePasswordPage_Back}"
            Canvas.Left="523"
            Canvas.Top="873"
            Width="394"
            Height="40"
            Background="#1E1E1E"
            BorderBrush="#1C1C1C"
            BorderThickness="1"
            FontFamily="Inter"
            FontSize="20"
            FontWeight="Bold"
            Foreground="#B3B3B3"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Click="btnBack_Click"/>

        <Button
            x:Name="btnLanguage"
            Content="{x:Static p:Resources.StartPage_Language}"
            Canvas.Right="1080"
            Canvas.Bottom="30"
            Width="120"
            Height="40"
            Background="#1E1E1E"
            Foreground="#B3B3B3"
            BorderBrush="#1C1C1C"
            BorderThickness="1"
            FontFamily="Inter"
            FontSize="16"
            Click="btnLanguage_Click"/>

    </Canvas>
</Window>