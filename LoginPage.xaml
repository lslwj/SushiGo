<Window x:Class="SushiGo.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SushiGo"
        xmlns:p="clr-namespace:SushiGo.Properties"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.LoginPage_Title}"
        Width="1280"
        Height="900"
        Background="#FFFAF4">

    <Canvas>

        <TextBlock
            Text="{x:Static p:Resources.LoginPage_Title}"
            Canvas.Left="247"
            Canvas.Top="109"
            Width="785"
            Height="106"
            FontFamily="./Fonts/#Protest Strike"
            FontSize="96"
            FontWeight="Normal"
            Foreground="#9B2424"
            TextAlignment="Center"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"/>


        <TextBlock
            Text="{x:Static p:Resources.LoginPage_LoginMethod}"
            Canvas.Left="443"
            Canvas.Top="316"
            Width="340"
            Height="23"
            FontFamily="Inter"
            FontSize="20"
            Foreground="#000000"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"/>


        <Border
            Canvas.Left="443"
            Canvas.Top="351"
            Width="394"
            Height="40"
            Background="#FFFAF4"
            BorderBrush="#B3B3B3"
            BorderThickness="1"
            CornerRadius="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">

            <TextBox
                Padding="14,0,14,0"
                FontFamily="Inter"
                FontSize="16"
                Background="Transparent"
                BorderThickness="0"/>
        </Border>


        <TextBlock
            Text="{x:Static p:Resources.LoginPage_Password}"
            Canvas.Left="443"
            Canvas.Top="432"
            Width="340"
            Height="23"
            FontFamily="Inter"
            FontSize="20"
            Foreground="#000000"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"/>


        <Border
            Canvas.Left="443"
            Canvas.Top="467"
            Width="394"
            Height="40"
            Background="#FFFAF4"
            BorderBrush="#B3B3B3"
            BorderThickness="1"
            CornerRadius="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">

            <PasswordBox
                Padding="14,0,14,0"
                FontFamily="Inter"
                FontSize="16"
                Background="Transparent"
                BorderThickness="0"/>
        </Border>


        <Button
            Content="{x:Static p:Resources.LoginPage_ForgotPassword}"
            Canvas.Left="443"
            Canvas.Top="518"
            Width="340"
            Height="23"
            Background="Transparent"
            BorderThickness="0"
            FontFamily="Inter"
            FontSize="16"
            Foreground="#000000"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Click="btnForgotPassword_Click"/>


        <Button
            Content="{x:Static p:Resources.LoginPage_LogIn}"
            Canvas.Left="443"
            Canvas.Top="574"
            Width="394"
            Height="40"
            Background="#1E1E1E"
            BorderBrush="#1C1C1C"
            BorderThickness="1"
            FontFamily="Inter"
            FontSize="20"
            FontWeight="Bold"
            Foreground="#B3B3B3"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"/>


        <Button
            x:Name="btnLanguage"
            Content="{x:Static p:Resources.StartPage_Language}"
            Canvas.Right="1080"
            Canvas.Bottom="30"
            Width="120"
            Height="40"
            Background="#1E1E1E"
            Foreground="#B3B3B3"
            BorderBrush="#1C1C1C"
            BorderThickness="1"
            FontFamily="Inter"
            FontSize="16"
            Click="btnLanguage_Click"/>

    </Canvas>

</Window>